{
  "schemaVersion": 1,
  "repository": "typixdeck/launcher",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.launcher",
    "package": "typix-launcher",
    "name": {
      "zh-CN": "启动器",
      "en": "Launcher"
    },
    "summary": {
      "zh-CN": "横向分类、桌面快捷方式去重、应用运行模式和触摸风扇温控曲线"
    },
    "description": {
      "zh-CN": "原生 GTK3 启动器，只读取桌面快捷方式，合并相同启动行为的副本，保留不同文件和 URL 参数。支持自动、单应用省内存或后台运行模式。设置内提供 CN5 EMC2301 四点可触摸拖动温控曲线、手动滑块和百分比输入和实时 PWM/RPM/温度，保留过热和异常全速保护；缺少驱动时禁用调速。"
    },
    "categories": [
      "System"
    ],
    "desktopFile": "typix-launcher.desktop",
    "runtime": {
      "kind": "python-module",
      "module": "typix_launcher",
      "root": "/usr/lib/python3/dist-packages"
    },
    "requiredPayload": [
      "/usr/bin/typix-launcher",
      "/usr/lib/python3/dist-packages/typix_launcher/__init__.py",
      "/usr/lib/python3/dist-packages/typix_launcher/__main__.py",
      "/usr/lib/python3/dist-packages/typix_launcher/app.py",
      "/usr/share/typix-launcher/typix-launcher.css",
      "/usr/lib/python3/dist-packages/typix_launcher/status.py",
      "/usr/lib/python3/dist-packages/typix_launcher/status_ui.py",
      "/usr/lib/python3/dist-packages/typix_launcher/battery.py",
      "/usr/lib/tmpfiles.d/typix-launcher.conf",
      "/usr/lib/python3/dist-packages/typix_launcher/runtime.py",
      "/usr/lib/python3/dist-packages/typix_launcher/handoff.py",
      "/usr/lib/python3/dist-packages/typix_launcher/desktop.py",
      "/usr/lib/python3/dist-packages/typix_launcher/supervisor.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan_helper.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan_service.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan_maintenance.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan_panel.py",
      "/usr/lib/python3/dist-packages/typix_launcher/fan_labels.py",
      "/usr/lib/python3/dist-packages/typix_launcher/names.py",
      "/usr/libexec/typix-launcher-fan",
      "/usr/share/polkit-1/actions/ai.typixdeck.launcher.fan.policy",
      "/usr/lib/systemd/system/typix-launcher-fan.service",
      "/usr/share/typix-launcher/typixdeck-cm4-emc2301.dtbo",
      "/usr/share/doc/typix-launcher/FAN-CONTROL.md"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    },
    "icon": "ai.typixdeck.launcher"
  },
  "release": {
    "version": "0.3.4-1",
    "file": "dist/typix-launcher_0.3.4-1_all.deb",
    "sha256": "5732b66c7dc292817295eade7df79e7c6d7a2257f07f8e011b67e015554bb9e1",
    "sizeBytes": 39992
  },
  "screenshots": [
    {
      "path": "docs/screenshots/categories.png",
      "caption": "0.3.3 横向分类标签（CM4 GTK 隔离演示）"
    },
    {
      "path": "docs/screenshots/fan-curve.png",
      "caption": "0.3.4 可触摸拖动风扇曲线（800×600 GTK 隔离演示）"
    },
    {
      "path": "docs/screenshots/runtime-settings.png",
      "caption": "0.3.0 应用运行模式设置（CM4 GTK 演示预览）"
    },
    {
      "path": "docs/screenshots/status.png",
      "caption": "0.2.2 纯图标状态栏与自动刷新（CM4 GTK 渲染，演示数据）"
    },
    {
      "path": "docs/screenshots/home.png",
      "caption": "桌面快捷方式首页与键盘焦点"
    },
    {
      "path": "docs/screenshots/settings.png",
      "caption": "开机自动启动设置"
    }
  ]
}
