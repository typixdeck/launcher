{
  "schemaVersion": 1,
  "repository": "typixdeck/launcher",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.launcher",
    "package": "typix-launcher",
    "name": {
      "zh-CN": "Typix 启动器",
      "en": "Typix Launcher"
    },
    "summary": {
      "zh-CN": "桌面快捷方式、实时电量与 Wi-Fi 信号的原生全屏启动器"
    },
    "description": {
      "zh-CN": "完整 GTK3 启动器，每次打开自动读取最新桌面快捷方式，启动应用并请求全屏，应用关闭后返回。顶部用纯图标显示电池电量与 Wi-Fi 信号，悬停可查看详情。"
    },
    "categories": [
      "System"
    ],
    "desktopFile": "typix-launcher.desktop",
    "runtime": {
      "kind": "python-module",
      "module": "typix_launcher",
      "root": "/usr/lib/python3/dist-packages"
    },
    "requiredPayload": [
      "/usr/bin/typix-launcher",
      "/usr/lib/python3/dist-packages/typix_launcher/__init__.py",
      "/usr/lib/python3/dist-packages/typix_launcher/__main__.py",
      "/usr/lib/python3/dist-packages/typix_launcher/app.py",
      "/usr/share/typix-launcher/typix-launcher.css",
      "/usr/lib/python3/dist-packages/typix_launcher/status.py",
      "/usr/lib/python3/dist-packages/typix_launcher/status_ui.py",
      "/usr/lib/python3/dist-packages/typix_launcher/battery.py",
      "/usr/lib/tmpfiles.d/typix-launcher.conf"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.2-1",
    "file": "dist/typix-launcher_0.2.2-1_all.deb",
    "sha256": "542d97c3dd74274672bb6478ffa83ccc3603807497090f56c7645977c149c0f7"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/status.png",
      "caption": "0.2.2 纯图标状态栏与自动刷新（CM4 GTK 渲染，演示数据）"
    },
    {
      "path": "docs/screenshots/home.png",
      "caption": "桌面快捷方式首页与键盘焦点"
    },
    {
      "path": "docs/screenshots/settings.png",
      "caption": "开机自动启动设置"
    }
  ]
}
